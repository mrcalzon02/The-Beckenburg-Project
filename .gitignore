# Transient lock files are recreated by native editor scene readers.
development/levels/rebuild/**/terrain-world/**/*.editor.lock
# Blender's automatic backups are not new candidate deliverables. Rejected
# studies are retained explicitly with their manifests and inspection captures.
development/levels/rebuild/terrain-fit-pass/**/*.blend[0-9]
# Recreated native-loader cache from hidden OpenGL verification.
/.lwjgl/

# Scoped Blender deck construction backups.
development/levels/rebuild/deck-fit-pass/**/*.blend[0-9]

# Scoped occupied-room terrain Blender backups.
development/levels/rebuild/terrain-occupancy-pass/**/*.blend[0-9]

# Scoped floor/cap Blender construction backups.
development/levels/rebuild/floor-closure-pass/**/*.blend[0-9]

# Scoped stair construction backups.
development/levels/rebuild/stair-landing-pass/**/*.blend[0-9]
