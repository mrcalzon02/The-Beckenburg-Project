+package org.beckenburg.gpu;
+
+import com.badlogic.gdx.Gdx;
+import com.badlogic.gdx.graphics.GL20;
+import com.badlogic.gdx.graphics.glutils.ShaderProgram;
+import java.nio.FloatBuffer;
+
+/** Positions/UVs and vertex lighting occupy adjacent regions of the same
+ * buffer. A lighting revision can replace the RGB region in one driver call. */
+final class ResidentVertexBuffer {
+    private final int[] vao = new int[1];
+    private final int buffer;
+    private final int position, uv, lighting;
+    private float[] geometry;
+    private long revision;
+
+    ResidentVertexBuffer(ShaderProgram shader) {
+        Gdx.gl30.glGenVertexArrays(1, vao, 0);
+        buffer = Gdx.gl.glGenBuffer();
+        position = shader.getAttributeLocation("a_position");
+        uv = shader.getAttributeLocation("a_texCoord0");
+        lighting = shader.getAttributeLocation("a_lighting");
+    }
+
+    boolean contains(long wantedRevision, int count) {
+        return revision == wantedRevision && geometry != null && geometry.length / 5 == count;
+    }
+
+    private boolean sameGeometry(float[] vertices) {
+        for (int src = 0, dst = 0; src < vertices.length; src += 8, dst += 5) {
+            for (int i = 0; i < 5; i++) {
+                if (Float.floatToRawIntBits(vertices[src+i]) != Float.floatToRawIntBits(geometry[dst+i])) return false;
+            }
+        }
+        return true;
+    }
+
+    /** Keep a snapshot of the geometry actually sent to GL. A skipped revision
+     * or a caller recycling its source array cannot invalidate the comparison. */
+    int upload(float[] vertices, long newRevision, FloatBuffer staging) {
+        int count = vertices.length / 8;
+        int geometryBytes = count * 5 * Float.BYTES;
+        boolean resized = geometry == null || geometry.length != count * 5;
+        boolean geometryChanged = resized || !sameGeometry(vertices);
+        staging.clear();
+        if (geometryChanged) {
+            if (resized) geometry = new float[count * 5];
+            for (int src = 0, dst = 0; src < vertices.length; src += 8, dst += 5)
+                System.arraycopy(vertices, src, geometry, dst, 5);
+            staging.put(geometry);
+        }
+        for (int i = 5; i < vertices.length; i += 8) staging.put(vertices, i, 3);
+        staging.flip();
+        int size = staging.remaining() * Float.BYTES;
+        Gdx.gl30.glBindVertexArray(vao[0]);
+        Gdx.gl.glBindBuffer(GL20.GL_ARRAY_BUFFER, buffer);
+        if (resized) {
+            Gdx.gl.glBufferData(GL20.GL_ARRAY_BUFFER, size, staging, GL20.GL_DYNAMIC_DRAW);
+            Gdx.gl.glEnableVertexAttribArray(position);
+            Gdx.gl.glVertexAttribPointer(position, 3, GL20.GL_FLOAT, false, 5 * Float.BYTES, 0);
+            Gdx.gl.glEnableVertexAttribArray(uv);
+            Gdx.gl.glVertexAttribPointer(uv, 2, GL20.GL_FLOAT, false, 5 * Float.BYTES, 3 * Float.BYTES);
+            Gdx.gl.glEnableVertexAttribArray(lighting);
+            Gdx.gl.glVertexAttribPointer(lighting, 3, GL20.GL_FLOAT, false, 3 * Float.BYTES, geometryBytes);
+        } else {
+            Gdx.gl.glBufferSubData(GL20.GL_ARRAY_BUFFER, geometryChanged ? 0 : geometryBytes, size, staging);
+        }
+        Gdx.gl.glBindBuffer(GL20.GL_ARRAY_BUFFER, 0);
+        revision = newRevision;
+        return size;
+    }
+
+    void render(int count) {
+        Gdx.gl30.glBindVertexArray(vao[0]);
+        Gdx.gl.glDrawArrays(GL20.GL_TRIANGLES, 0, count);
+        Gdx.gl30.glBindVertexArray(0);
+    }
+
+    void dispose() {
+        Gdx.gl.glDeleteBuffer(buffer);
+        Gdx.gl30.glDeleteVertexArrays(1, vao, 0);
+    }
+}
