+    private record CpuBoundary(long wallNs, long processCpuNs) {}
+    private final boolean profileCpu = Boolean.getBoolean("beckenburg.profile.phaseCpu");
+    private final com.sun.management.OperatingSystemMXBean cpuBean = profileCpu
+        && ManagementFactory.getOperatingSystemMXBean() instanceof com.sun.management.OperatingSystemMXBean os ? os : null;
+    private final LinkedHashMap<String, CpuBoundary> cpuBoundaries = new LinkedHashMap<>();
+
+    private void enterMeasuredPhase(String next) {
+        if (profileCpu) {
+            long cpu = cpuBean == null ? -1 : cpuBean.getProcessCpuTime();
+            cpuBoundaries.put(next, new CpuBoundary(System.nanoTime(), cpu));
+        }
+        phase = next;
+    }
+
+    private void writeCpuPhases(Path output) throws java.io.IOException {
+        if (!profileCpu) return;
+        try (var out = Files.newBufferedWriter(output.resolve("phase-cpu.csv"))) {
+            out.write("phase,start_wall_ns,end_wall_ns,start_process_cpu_ns,end_process_cpu_ns,wall_ns,process_cpu_ns,core_equivalents\n");
+            for (String name : List.of("idle", "moving", "stopping")) {
+                var start = cpuBoundaries.get(name);
+                if (start == null) continue;
+                var end = cpuBoundaries.get(switch (name) {
+                    case "idle" -> "moving";
+                    case "moving" -> "cooldown";
+                    default -> "finished";
+                });
+                long wall = end.wallNs() - start.wallNs();
+                String totals = ",";
+                if (start.processCpuNs() >= 0 && end.processCpuNs() >= start.processCpuNs() && wall > 0) {
+                    long cpu = end.processCpuNs() - start.processCpuNs();
+                    totals = String.format(Locale.ROOT, "%d,%.6f", cpu, (double)cpu / wall);
+                }
+                out.write(String.format(Locale.ROOT, "%s,%d,%d,%d,%d,%d,%s%n", name,
+                    start.wallNs(), end.wallNs(), start.processCpuNs(), end.processCpuNs(), wall, totals));
+            }
+        }
+    }
